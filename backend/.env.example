# Flask security (use unique, secret values outside local development)
SECRET_KEY=replace-with-a-secure-secret-key
JWT_SECRET_KEY=replace-with-a-secure-jwt-secret-key

# Database (SQLite locally; PostgreSQL URL can be used later)
DATABASE_URL=sqlite:///threatwatch_ot.db

# Comma-separated browser origins permitted to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Local Flask development server
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
JWT_ACCESS_TOKEN_EXPIRES=3600
AUTO_CREATE_DATABASE=true

# Reserved for future threat-intelligence and integration providers
THREAT_INTEL_API_KEY=
OT_INTEGRATION_API_KEY=
